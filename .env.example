# ---------------------------------------------------------------------------
# 复制成 .env 后按需修改
# ---------------------------------------------------------------------------

# 网关令牌与地址（用 RELAY_* 可避免和系统里给 Codex 设置的 OPENAI_* 冲突）
RELAY_API_KEY=sk-your-token-here
RELAY_BASE_URL=http://token.wd.com

# 默认模型：gpt-image-2.5-sunburst | gpt-image-2 | gpt-image-2.5-flare
DEFAULT_MODEL=gpt-image-2.5-sunburst
# 调用方式：images(/v1/images/generations) | openai(/v1/chat/completions) | gemini
DEFAULT_API_STYLE=images
# 令牌发送方式：bearer（Authorization: Bearer）| x-goog-api-key
AUTH_STYLE=bearer

# 网络
REQUEST_TIMEOUT=300
MAX_RETRIES=2
RETRY_BACKOFF=5
# HTTP_PROXY_URL=http://127.0.0.1:7890

# 目录
HARNESS_DIR=hareness
OUTPUT_DIR=resource
# COMMON_FILE=common.yaml